# Секреты — никогда не должны попасть в образ (передаём через --env-file).
.env

# Локальное окружение и кэш Python.
.venv/
__pycache__/
*.pyc

# Локальная база данных — подключается через volume, не вшивается в образ.
data/
local.db
local.db-wal
local.db-shm

# Git и прочее, что не нужно в образе.
.git/
.gitignore
