# ===== Mattermost =====
URL=localhost
MM_SCHEME=http
MM_PORT=8065
BOT_TOKEN=your_bot_token
BOT_USERNAME=your_bot_username
BIRTHDAY_TEAM_NAME=mattermost_team_name

# ===== База данных =====
# Путь внутри контейнера. data/ монтируется томом (-v ./data:/app/data),
# поэтому БД переживает пересоздание контейнера.
DB_PATH=data/bot.db

# ===== Планировщик =====
# SCHEDULER_MODE=test OR prod ; SCHEDULER_INTERVAL — минуты (в test-режиме)
SCHEDULER_MODE=test
SCHEDULER_INTERVAL=10

# ===== HTTP-сервер кнопок =====
# BUTTON_PORT — порт ВНУТРИ контейнера (правая часть -p и EXPOSE в Dockerfile).
BUTTON_PORT=8081
# BOT_PUBLIC_URL — адрес, по которому MM стучится к боту = ХОСТ:порт хоста
# (левая часть -p). Локально: host.docker.internal; прод: http://<IP хоста>:8082
BOT_PUBLIC_URL=http://host.docker.internal:8082

# ===== Прод (корп-хост), для справки =====
# URL=feature-sandbox.tag-test.corp.tander.ru
# MM_SCHEME=https
# MM_PORT=443
# BOT_PUBLIC_URL=http://<IP хоста>:8082
